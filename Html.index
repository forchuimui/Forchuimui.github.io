<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Chumui ❤️</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: "Segoe UI", sans-serif;
    background: #090313;
    color: white;
    overflow: hidden;
}

/* =========================
   SCREEN SYSTEM
========================= */

.screen {
    position: fixed;
    inset: 0;
    display: none;
    justify-content: center;
    align-items: center;
    padding: 25px;
    text-align: center;
    background:
        radial-gradient(circle at top, #3b123f 0%, #16051d 45%, #090313 100%);
}

.screen.active {
    display: flex;
    animation: screenIn 0.7s ease;
}

@keyframes screenIn {
    from {
        opacity: 0;
        transform: scale(1.05);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.content {
    width: 100%;
    max-width: 600px;
    position: relative;
    z-index: 5;
}

h1 {
    font-size: clamp(2.2rem, 9vw, 4.5rem);
    margin-bottom: 20px;
}

h2 {
    font-size: clamp(1.8rem, 7vw, 3rem);
    margin-bottom: 20px;
}

p {
    font-size: 1.08rem;
    line-height: 1.7;
    color: #eaddea;
}

/* =========================
   HEARTS
========================= */

.heart {
    position: fixed;
    bottom: -30px;
    font-size: 20px;
    opacity: 0.7;
    pointer-events: none;
    animation: floatHeart linear forwards;
    z-index: 1;
}

@keyframes floatHeart {
    from {
        transform: translateY(0) rotate(0deg);
        opacity: 0;
    }

    15% {
        opacity: 0.8;
    }

    to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
    }
}

/* =========================
   BUTTONS
========================= */

button {
    border: none;
    border-radius: 50px;
    padding: 15px 30px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    margin: 10px;
    transition: 0.25s;
    -webkit-tap-highlight-color: transparent;
}

.primary {
    background: linear-gradient(135deg, #ff4f9a, #ff1744);
    color: white;
    box-shadow: 0 8px 30px rgba(255, 23, 68, 0.35);
}

.primary:hover {
    transform: scale(1.06);
}

.secondary {
    background: rgba(255,255,255,0.1);
    color: white;
    border: 1px solid rgba(255,255,255,0.2);
}

/* =========================
   LANDING
========================= */

.eyebrow {
    color: #ff7fb7;
    letter-spacing: 4px;
    text-transform: uppercase;
    font-size: 0.8rem;
    margin-bottom: 18px;
}

.big-heart {
    font-size: 80px;
    animation: heartbeat 1.3s infinite;
    margin-bottom: 15px;
}

@keyframes heartbeat {
    0%,100% { transform: scale(1); }
    15% { transform: scale(1.15); }
    30% { transform: scale(1); }
}

/* =========================
   TYPING
========================= */

.typing {
    min-height: 130px;
    font-size: 1.25rem;
    color: #fff1f8;
}

.cursor {
    border-right: 2px solid #ff75b5;
    animation: blink 0.7s infinite;
}

@keyframes blink {
    50% { border-color: transparent; }
}

/* =========================
   TIMELINE
========================= */

.timeline {
    margin: 30px auto;
    max-height: 55vh;
    overflow-y: auto;
    padding: 10px;
    text-align: left;
}

.timeline-item {
    position: relative;
    margin: 20px 0;
    padding: 18px;
    background: rgba(255,255,255,0.07);
    border-left: 3px solid #ff4f9a;
    border-radius: 12px;
    animation: slideUp 0.7s ease;
}

.timeline-item h3 {
    color: #ff83b9;
    margin-bottom: 7px;
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================
   FINAL QUESTION
========================= */

.question {
    font-size: clamp(2rem, 9vw, 4rem);
    margin-bottom: 15px;
}

.buttons-area {
    position: relative;
    height: 180px;
    margin-top: 20px;
}

#yesBtn {
    position: relative;
    z-index: 20;
}

#noBtn {
    position: absolute;
    left: 50%;
    top: 80px;
    transform: translateX(-50%);
    background: #333;
    color: white;
    z-index: 10;
}

/* =========================
   FINAL SCREEN
========================= */

.final-heart {
    font-size: 100px;
    animation: heartbeat 1.2s infinite;
}

.small {
    font-size: 0.9rem;
    opacity: 0.65;
    margin-top: 20px;
}
</style>
</head>

<body>

<!-- =========================
     SCREEN 1
========================= -->

<section class="screen active" id="screen1">
    <div class="content">

        <div class="big-heart">❤️</div>

        <div class="eyebrow">A little something for</div>

        <h1>Chumui</h1>

        <p>
            I made this little website because<br>
            some things are easier to say from the heart.
        </p>

        <br>

        <button class="primary" onclick="nextScreen(2)">
            Start ❤️
        </button>

    </div>
</section>


<!-- =========================
     SCREEN 2
========================= -->

<section class="screen" id="screen2">
    <div class="content">

        <div class="eyebrow">First of all...</div>

        <h2>I'm sorry, Chumui.</h2>

        <div class="typing">
            <span id="typingText"></span><span class="cursor"></span>
        </div>

        <button class="primary" onclick="nextScreen(3)">
            Continue 💌
        </button>

    </div>
</section>


<!-- =========================
     SCREEN 3
========================= -->

<section class="screen" id="screen3">
    <div class="content">

        <div class="eyebrow">Our little story</div>

        <h2>Some moments ❤️</h2>

        <div class="timeline">

            <div class="timeline-item">
                <h3>🌸 The Beginning</h3>
                <p>
                    Somewhere along the way, you became someone
                    incredibly special to me.
                </p>
            </div>

            <div class="timeline-item">
                <h3>😊 The Little Things</h3>
                <p>
                    The conversations, laughs, silly moments,
                    and all those little memories started meaning
                    more than I realized.
                </p>
            </div>

            <div class="timeline-item">
                <h3>❤️ What You Mean To Me</h3>
                <p>
                    You're not just another person in my life.
                    You're someone I genuinely don't want to hurt.
                </p>
            </div>

            <div class="timeline-item">
                <h3>🥺 Today</h3>
                <p>
                    And that's why I'm here saying the simplest
                    words I should have said sooner...
                </p>
            </div>

        </div>

        <button class="primary" onclick="nextScreen(4)">
            Next ❤️
        </button>

    </div>
</section>


<!-- =========================
     SCREEN 4
========================= -->

<section class="screen" id="screen4">
    <div class="content">

        <div class="big-heart">💗</div>

        <h2>One more thing...</h2>

        <p>
            I know saying sorry doesn't magically erase
            everything.<br><br>

            But I hope you know that I mean it.
            I care about you, I value you,
            and I don't want one mistake to become
            bigger than everything good between us.
        </p>

        <br>

        <button class="primary" onclick="nextScreen(5)">
            One last question 🥺
        </button>

    </div>
</section>


<!-- =========================
     SCREEN 5
========================= -->

<section class="screen" id="screen5">
    <div class="content">

        <div class="eyebrow">Be honest...</div>

        <div class="question">
            Do you forgive me? 🥺
        </div>

        <p id="reactionText">
            Think carefully... 👀
        </p>

        <div class="buttons-area">

            <button
                id="yesBtn"
                class="primary"
                onclick="forgive()">
                YES ❤️
            </button>

            <button
                id="noBtn"
                onclick="runAway(event)">
                NO 😐
            </button>

        </div>

    </div>
</section>


<!-- =========================
     SCREEN 6
========================= -->

<section class="screen" id="screen6">
    <div class="content">

        <div class="final-heart">💖</div>

        <h1>Thank you, Chumui.</h1>

        <p>
            I promise I'll try to be better,
            understand you better,
            and take better care of what we have.
        </p>

        <br>

        <h2>You're very special to me. ❤️</h2>

        <p class="small">
            Made with a lot of love and a little bit of panic 😭
        </p>

    </div>
</section>


<script>

/* =========================
   SCREEN NAVIGATION
========================= */

function nextScreen(number) {

    document.querySelectorAll(".screen").forEach(screen => {
        screen.classList.remove("active");
    });

    const next = document.getElementById("screen" + number);

    next.classList.add("active");

    if (number === 2) {
        startTyping();
    }

    createHearts();
}


/* =========================
   TYPING ANIMATION
========================= */

let typingStarted = false;

function startTyping() {

    if (typingStarted) return;

    typingStarted = true;

    const text =
    "I know I messed up. And I'm genuinely sorry. I never wanted to hurt you or make you feel bad. You mean much more to me than my mistakes sometimes show.";

    const element = document.getElementById("typingText");

    let i = 0;

    function type() {

        if (i < text.length) {

            element.textContent += text.charAt(i);

            i++;

            setTimeout(type, 35);

        }
    }

    type();
}


/* =========================
   FALLING HEARTS
========================= */

function createHeart() {

    const heart = document.createElement("div");

    heart.className = "heart";

    const hearts = ["❤️","💕","💗","💖","💓","💘"];

    heart.textContent =
        hearts[Math.floor(Math.random() * hearts.length)];

    heart.style.left =
        Math.random() * 100 + "vw";

    heart.style.fontSize =
        (15 + Math.random() * 20) + "px";

    heart.style.animationDuration =
        (4 + Math.random() * 5) + "s";

    document.body.appendChild(heart);

    setTimeout(() => {
        heart.remove();
    }, 9000);
}

function createHearts() {

    for (let i = 0; i < 8; i++) {

        setTimeout(() => {
            createHeart();
        }, i * 200);

    }
}

setInterval(createHeart, 1200);


/* =========================
   RUNNING NO BUTTON
========================= */

const noTexts = [
    "NO 😐",
    "Are you sure? 🥺",
    "Really? 😭",
    "Think again! 😭",
    "Please? 🥹",
    "Don't do this 😭",
    "You can't catch me 😈",
    "Try YES instead ❤️",
    "I'm moving! 😂",
    "Okay okay... YES? 🥺"
];

let noIndex = 0;

function runAway(event) {

    if (event) {
        event.preventDefault();
    }

    const button = document.getElementById("noBtn");
    const area = document.querySelector(".buttons-area");
    const reaction = document.getElementById("reactionText");

    noIndex++;

    button.textContent =
        noTexts[noIndex % noTexts.length];

    const maxX = Math.max(
        0,
        area.clientWidth - button.offsetWidth
    );

    const maxY = Math.max(
        0,
        area.clientHeight - button.offsetHeight
    );

    const x = Math.random() * maxX;
    const y = Math.random() * maxY;

    button.style.left = x + "px";
    button.style.top = y + "px";
    button.style.transform = "none";

    const messages = [
        "Nope 😂",
        "That button doesn't work!",
        "You have to catch me first 😭",
        "I'm not letting you say no 😭",
        "YES is looking pretty good right now 👀",
        "Nice try 😂",
        "I'm faster than you 😈"
    ];

    reaction.textContent =
        messages[Math.floor(Math.random() * messages.length)];

    createHearts();
}


/* =========================
   ALSO DODGE TOUCH / HOVER
========================= */

const noButton = document.getElementById("noBtn");

noButton.addEventListener("mouseenter", () => {
    runAway();
});

noButton.addEventListener("touchstart", (event) => {
    runAway(event);
});


/* =========================
   YES BUTTON
========================= */

function forgive() {

    createHearts();

    setTimeout(() => {
        nextScreen(6);
    }, 300);

}

</script>

</body>
</html>